# Copy this file to .env (`make setup` does it) and fill in your keys. Never commit .env.
# Every cap below is a hard limit the course code enforces; pages quote these names, not estimates.

# Model provider key.
OPENAI_API_KEY=
# Tracing service key, if the module traces runs.
LANGSMITH_API_KEY=

# The most one run may cost, in US dollars.
MAX_RUN_COST_USD=0.25
# The most one class session may cost, in US dollars.
MAX_SESSION_COST_USD=2.50
# The class day (YYYY-MM-DD), for runs traced to the class project.
CLASS_DATE=
