[importlinter]
root_package = app

[importlinter:contract:api-not-db]
name = R6: app.api never imports app.db
type = forbidden
source_modules =
    app.api
forbidden_modules =
    app.db
allow_indirect_imports = True

[importlinter:contract:layers]
name = Layers: api -> services -> repositories -> db
type = layers
layers =
    app.api
    app.services
    app.repositories
    app.db
