      "updated": 1,
      "link": null,
      "locked": false,
      "text": "## Machine summary\nWritten by the harness at the end\nof session N (phase, what ended it, turns)\n- Commits: start, end\n- Files changed in this session\n- Visible tests\n- Last commits\n- Open TODO markers\n- Migration heads\n- Harness documents read so far",
      "fontSize": 27.66,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "handoff-contents-rectangle-3",
      "originalText": "## Machine summary\nWritten by the harness at the end\nof session N (phase, what ended it, turns)\n- Commits: start, end\n- Files changed in this session\n- Visible tests\n- Last commits\n- Open TODO markers\n- Migration heads\n- Harness documents read so far",
      "autoResize": true,
      "lineHeight": 1.25
    },
